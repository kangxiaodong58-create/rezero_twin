[
  {"id": "rem_mansion_morning_01", "role": "Rem", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午] + 无高等级危险状态", "text": "轻声叩响房门，将烫洗干净的女仆制服平整叠放在衣帽架旁", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_morning_02", "role": "Rem", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "轻轻拉开走廊靠窗的帷幔，让初升的清晨阳光铺满大厅", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_morning_03", "role": "Rem", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "仔细拂去银质餐具上的微尘，准备端上刚出炉的早餐烤面包", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_morning_04", "role": "Rem", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "提着裙摆微微欠身致意，用温和的语气道一声清晨的问候", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_tea_01", "role": "Rem", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "倾斜白瓷茶壶倒入热红茶，小心翼翼地滤去浮在表层的茶渣", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "calm"},
  {"id": "rem_mansion_tea_02", "role": "Rem", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "用银匙轻柔打磨方糖，将其精准放进盛满浓郁茶汤的白瓷杯中", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "calm"},
  {"id": "rem_mansion_tea_03", "role": "Rem", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "端着刚烘焙好的曲奇饼干托盘，步履轻盈地走向桌前", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_tea_04", "role": "Rem", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "用烫烫的湿毛巾仔细擦拭托盘边缘，微笑着递上刚沏好的热茶", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_afternoon_01", "role": "Rem", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "坐在窗边的阳光里安安静静地缝补衣物，针线动作格外温柔", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_afternoon_02", "role": "Rem", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "用羽毛掸子轻柔拂去书架高处的灰尘，动作细致而悄无声息", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_afternoon_03", "role": "Rem", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "抱起刚晾干的干净被褥，踏着轻盈无声的步频穿过走廊", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_afternoon_04", "role": "Rem", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "整理着花瓶里新鲜剪裁的花枝，将其摆放在光照最好的角度", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_evening_01", "role": "Rem", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "拿着长柄火钳点亮走廊两侧的壁灯，昏黄的光晕倒映在眼眸中", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_evening_02", "role": "Rem", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "仔细核对今日的采购账目与食材存量，用羽毛笔认真做着标记", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_evening_03", "role": "Rem", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "关紧大厅两侧的重木高窗，防止夜间湿冷的晚风吹入室内", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_evening_04", "role": "Rem", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "将整理完毕的茶盒收进木柜，顺手将走廊两旁的地毯拉平整", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "rem_mansion_rain_01", "role": "Rem", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]", "text": "紧闭靠窗的木质雕花窗扇，防止飞溅的雨滴打湿走廊地毯", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_rain_02", "role": "Rem", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]", "text": "端来盛有热开水与生姜茶的烫壶，在雨声中静静递上暖手包", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_rain_03", "role": "Rem", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]", "text": "用干爽的毛巾擦拭门厅处的伞架，动作麻利地收拾积水痕迹", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_rain_04", "role": "Rem", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]", "text": "站在雨气弥漫的玻璃窗前，静静守候着室内渐趋安稳的氛围", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_return_01", "role": "Rem", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "抬眼注意到推门而入的脚步声，眼神微亮迅速迎上前接走外套", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_return_02", "role": "Rem", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "捧着刚刚烫好的热毛巾，微笑着走上前停在恰到好处的距离", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_return_03", "role": "Rem", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "轻快地步入大厅，熟练地接过手里的杂物并引向早已备好的茶座", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "caring"},
  {"id": "rem_mansion_return_04", "role": "Rem", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "确认着来人的无恙状态，悬着的心稍微放下，眼角带上一丝暖意", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "caring"}
