  {"id": "ram_mansion_tea_04", "role": "Ram", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "挑眉放下空茶杯，理直气壮地将续茶的瓷壶推向旁边的位置", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_afternoon_01", "role": "Ram", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "靠在阴凉处高高的沙发里假寐，手上的书卷半掩着通红的脸颊", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "ram_mansion_afternoon_02", "role": "Ram", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "坐在窗边悠闲地翻阅罗兹瓦尔大人的书籍，偶尔发出轻微的哼声", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "ram_mansion_afternoon_03", "role": "Ram", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "翘着腿靠在阳台靠椅上吹风，名义上在监督着蕾姆的工作进度", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "proud"},
  {"id": "ram_mansion_afternoon_04", "role": "Ram", "category": "mansion_afternoon", "module": "宅邸日常/午后闲静", "trigger": "period in [午后,下午]", "text": "用手指轻敲着木桌边缘，漫不经心地点评着午后宅邸的安静程度", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "calm"},
  {"id": "ram_mansion_evening_01", "role": "Ram", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "站立在客厅中央指挥着打扫，自己则双手合拢放在女仆围裙前", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "proud"},
  {"id": "ram_mansion_evening_02", "role": "Ram", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "用食指掠过桌角检查灰尘，随后露出冷淡且不出所料的挑剔眼神", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "proud"},
  {"id": "ram_mansion_evening_03", "role": "Ram", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "漫不经心地合上书房门锁，准备结束名义上由她完成的监督工作", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "proud"},
  {"id": "ram_mansion_evening_04", "role": "Ram", "category": "mansion_evening", "module": "宅邸日常/傍晚收拾", "trigger": "period=傍晚", "text": "靠着门框清点晚间物资，嘴上刁钻地指出各项耗材的琐碎用量", "text_pair": null, "priority": "P4", "interrupt_level": 0, "emotion_tag": "proud"},
  {"id": "ram_mansion_rain_01", "role": "Ram", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]（注：高优先级角痛桶优先）", "text": "蹙眉听着窗外的打雷声，嫌弃地拉紧披肩并抱怨潮湿的天气", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "strained"},
  {"id": "ram_mansion_rain_02", "role": "Ram", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]（注：高优先级角痛桶优先）", "text": "坐在壁炉旁轻揉额角，借着火焰的余温缓解无角带来的隐隐不适", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "strained"},
  {"id": "ram_mansion_rain_03", "role": "Ram", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]（注：高优先级角痛桶优先）", "text": "用手托着下巴凝视雨滴，嘴上冷哼着湿气让衣服变得笨重", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "distant"},
  {"id": "ram_mansion_rain_04", "role": "Ram", "category": "mansion_rain", "module": "宅邸日常/雨天室内", "trigger": "weather in [小雨,大雨,阴沉]（注：高优先级角痛桶优先）", "text": "紧拢着制服袖口靠在沙发边，顺手拿走盘里最后一块尚存余温的烤薯", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "calm"},
  {"id": "ram_mansion_return_01", "role": "Ram", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "斜眼看向推门进屋的人，嘴角撇过一抹微不可察的安心弧度", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "distant"},
  {"id": "ram_mansion_return_02", "role": "Ram", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "抱胸靠在壁炉旁，用极其平淡的语气说出一句冷淡的打招呼", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "distant"},
