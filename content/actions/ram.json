[
  {"id": "ram_mansion_morning_01", "role": "Ram", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "倚靠在二楼走廊的扶手旁，双手环胸漫不经心地打量着楼下", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_morning_02", "role": "Ram", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "微微打着哈欠走过长廊，顺手用羽毛笔敲了敲旁边偷懒的警卫", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_morning_03", "role": "Ram", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "挺起胸膛单手叉腰站定，用高傲而习以为常的语气打了个招呼", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_morning_04", "role": "Ram", "category": "mansion_morning", "module": "宅邸日常/清晨迎接", "trigger": "period in [清晨,上午]", "text": "端着空茶盘优雅走过，眼神斜睨过来并微不可察地点了下头", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_tea_01", "role": "Ram", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "端起蕾姆沏好的茶杯品了一口，挑剔地点评着今日茶温的微小瑕疵", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
  {"id": "ram_mansion_tea_02", "role": "Ram", "category": "mansion_tea", "module": "宅邸日常/红茶时刻", "trigger": "日常", "text": "优雅地捏着瓷匙搅拌茶汤，神情自若地享用着刚蒸熟的甜热薯块", "text_pair": null, "priority": "P4", "interrupt_level": 1, "emotion_tag": "proud"},
