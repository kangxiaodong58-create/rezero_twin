  {"id": "ram_mansion_return_04", "role": "Ram", "category": "mansion_return", "module": "宅邸日常/离线归来", "trigger": "days_since_last > 0", "text": "佯装没注意到开门声，直到对方走近才冷冷地吐出一句讽刺的关切", "text_pair": null, "priority": "P3", "interrupt_level": 1, "emotion_tag": "distant"}
